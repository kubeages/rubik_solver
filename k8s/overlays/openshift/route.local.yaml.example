# Copy to route.local.yaml, set your real host(s), and apply it after the
# kustomize deploy. route.local.yaml is gitignored, and the overlay does not
# manage Routes, so re-applying the overlay never overwrites your host.
#
#   oc apply -k k8s/overlays/openshift/
#   oc apply -f k8s/overlays/openshift/route.local.yaml
#
# The camera only works over HTTPS, so keep the edge TLS termination.
# Add a second Route (as below) if you also publish the app on another domain.

apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: rubik-solver
  annotations:
    haproxy.router.openshift.io/timeout: "90s"
spec:
  host: rubik-solver.your-cluster.example.com
  to:
    kind: Service
    name: rubik-solver
  port:
    targetPort: 8080
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
