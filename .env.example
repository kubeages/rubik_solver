# Copy to .env and fill in your values. .env is gitignored.

# OpenAI-compatible LLM endpoint for the tutor (vLLM, Ollama, ...).
# Leave VLLM_ENDPOINT empty to run without the tutor: the solver does not need it.
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=qwen32b
VLLM_API_KEY=
VLLM_TIMEOUT=60

# Login gate. Leave AUTH_PASSWORD/AUTH_PASSWORD_HASH empty to run without login
# (fine locally, not on a public URL). Generate a hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('tu-contraseña'))"
AUTH_USER=
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
# More accounts, separated by commas: "ana:<hash>,luis:<hash>"
AUTH_USERS=
AUTH_SESSION_DAYS=30
# SECRET_KEY signs the session cookie; derived from the password if unset.
SECRET_KEY=
# Set to 0 only if you serve the app over plain http.
COOKIE_SECURE=1

# Optional: shown in the page footer (e.g. your public hostname).
SITE_DOMAIN=

# Search budget of the fast (two-phase) solver, in seconds.
SOLVE_SECONDS=2.5
